DATABASE_URL=postgresql://leetcode:leetcode@localhost:5432/leetcode
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-in-production
PORT=4000
FRONTEND_URL=http://localhost:5173

# --- Judge worker ----------------------------------------------------------
# The worker runs in its own process (`npm run worker -w backend`) and is the
# only component that talks to Docker.
JUDGE_CONCURRENCY=2
JUDGE_TIMEOUT_MS=10000
JUDGE_MAX_OUTPUT_BYTES=65536
JUDGE_TMPFS_MB=64
# How long an HTTP request waits for the worker before falling back to polling.
JUDGE_SUBMIT_WAIT_MS=30000
JUDGE_RUN_WAIT_MS=45000
# Directory used for per-job bind mounts. Must be visible to the Docker daemon.
# JUDGE_WORK_DIR=/var/lib/codeforge/jobs

# Execution images (override to pin versions or use an internal registry).
# JUDGE_IMAGE_JAVASCRIPT=node:22-alpine
# JUDGE_IMAGE_PYTHON=python:3.12-alpine
# JUDGE_IMAGE_C=gcc:13-bookworm
# JUDGE_IMAGE_CPP=gcc:13-bookworm
# JUDGE_IMAGE_GO=golang:1.22-alpine
# JUDGE_IMAGE_RUST=rust:1-alpine
